<?xml version="1.0" encoding="utf-8"?>
<!-- A mesh of peers: four outer nodes linked to each other and through the
     centre, the shape STUNMESH builds by punching holes between peers.
     Drawn inside the 72dp adaptive-icon safe zone (18..90 of 108). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Links around the square -->
    <path
        android:pathData="M36,36 L72,36 L72,72 L36,72 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeAlpha="0.5"
        android:strokeLineJoin="round" />

    <!-- Diagonals through the centre -->
    <path
        android:pathData="M36,36 L72,72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M72,36 L36,72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round" />

    <!-- Peer nodes -->
    <path
        android:pathData="M36,36m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M72,36m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M72,72m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M36,72m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
        android:fillColor="#FFFFFF" />

    <!-- This device, at the centre -->
    <path
        android:pathData="M54,54m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M54,54m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0"
        android:fillColor="#1B3A6B" />
